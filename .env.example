# Resend (contact form + service quote form)
RESEND_API_KEY=resend_api_key
# Verified sender address/domain in Resend. Avoid a "noreply@" local part —
# Resend itself flags it as signaling one-way communication, which lowers
# inbox trust (replies still route to the visitor via Reply-To regardless
# of this address).
RESEND_FROM_EMAIL=Chrod <hello@yourdomain.com>
# Inbox that receives contact/quote submissions
RESEND_TO_EMAIL=you@example.com

PUBLIC_SANITY_PROJECT_ID=project_id
PUBLIC_SANITY_DATASET=production

# Required for the client review submission form
# Create a token in Sanity → Manage → API → Tokens with "Editor" permissions
SANITY_WRITE_TOKEN=sanity_write_token

# Secret token that protects the review form — include in the URL: /review?t=YOUR_TOKEN
# Use any random string
REVIEW_ACCESS_TOKEN=your_review_access_token

# WhatsApp Embedded Signup (CHRod Connect Tech Provider app)
# App ID and Embedded Signup config ID from developers.facebook.com → app → WhatsApp.
# These two are PUBLIC_ because the client-side JS SDK needs them.
PUBLIC_WHATSAPP_APP_ID=your_meta_app_id
PUBLIC_WHATSAPP_CONFIG_ID=your_embedded_signup_config_id
# App secret — developers.facebook.com → app → Settings → Basic → "App Secret". Server-only, never
# exposed to the browser. Also used (as an app access token, app_id|app_secret) to confirm which
# WABA an Embedded Signup actually granted, via debug_token — that call specifically rejects a
# system-user token ("must provide an app access token, or a user token that owns the app").
WHATSAPP_APP_SECRET=your_meta_app_secret
# System-user access token (whatsapp_business_management, scoped to this app — same kind already
# used for n8n) used to read /phone_numbers on the WABA found above. Unlike debug_token, this one
# rejects the app access token instead ("You do not have permission to access this field") since
# it's reading real business asset data, not just introspecting a token. Generate in Business
# Settings → Users → System users → this app. Optional: without it, the phone number lookup is
# skipped and the email falls back to the client-reported (unverified) phone_number_id.
WHATSAPP_SYSTEM_USER_TOKEN=your_system_user_token
# Signs/verifies the `cliente`+`sig` query params on the onboarding link
# (src/pages/[lang]/connect.astro, src/lib/whatsappOnboard.ts). Set once;
# changing it invalidates every link generated before the change.
# Use any random string.
WHATSAPP_LINK_SECRET=your_whatsapp_link_secret

# Secret token that protects the internal link-generator tool —
# include in the URL: /es/admin-links?t=YOUR_TOKEN. Use any random string.
ADMIN_ACCESS_TOKEN=your_admin_access_token

# Base site URL used when building onboarding links server-side (no trailing slash).
PUBLIC_SITE_URL=https://chrod.dev
