---
import { ClientRouter } from "astro:transitions";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import "../styles/global.css";
import type { Locale } from "../i18n/ui";
import {
  getAlternatePaths,
  withLocale,
  type AlternatePaths,
} from "../i18n/routes";
import {
  buildGraph,
  buildIdentityGraph,
  getSiteUrl,
  type JsonLd,
} from "../lib/schema";
import {
  assertTitleLength,
  composeTitle,
  isTitleLengthExempt,
} from "../lib/seo";
import { isAnalyticsExcluded } from "../lib/analytics";

export interface Props {
  /**
   * Keyword part of the title only, without the brand. `MainLayout` appends
   * `| CHRod Dev` so the suffix cannot vary per page. See `src/lib/seo.ts`.
   */
  title?: string;
  description?: string;
  lang?: Locale;
  canonicalUrl?: string;
  /** This page's unprefixed path in each language — see `src/i18n/routes.ts`. */
  alternates?: AlternatePaths;
  /** Keeps the page out of search results and drops its canonical/hreflang tags. */
  noindex?: boolean;
  showWhatsAppButton?: boolean;
  /**
   * Page-specific JSON-LD nodes, appended to the identity graph that every
   * page emits. Build them with the helpers in `src/lib/schema.ts` — that
   * file also documents which types still earn a rich result and which do not.
   */
  jsonLd?: JsonLd[];
}

const {
  title = "Full Stack Web Developer",
  description = "Full stack web developer specializing in React, Node.js & modern web technologies. Available for freelance projects. Landing pages, web apps, e-commerce & API development.",
  lang = "en",
  canonicalUrl,
  alternates = getAlternatePaths("home"),
  noindex = false,
  showWhatsAppButton = true,
  jsonLd = [],
} = Astro.props;

const siteUrl = getSiteUrl(Astro.site);
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;

// Unset id means no analytics at all, which is how local development and
// deploy previews stay out of the numbers: the id is scoped to the production
// context in netlify.toml. `isAnalyticsExcluded` keeps the token-gated routes
// out, since Umami records query strings and theirs hold credentials.
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const trackAnalytics =
  Boolean(umamiWebsiteId) && !isAnalyticsExcluded(Astro.url.pathname);

const fullTitle = composeTitle(title);
if (!isTitleLengthExempt(Astro.url.pathname)) {
  assertTitleLength(fullTitle, Astro.url.pathname);
}
const ogImage = `${siteUrl}/og-image.png`;

// A noindex page contributes nothing to entity understanding and should not
// assert identity claims search engines might attach to a dead URL.
const graph = noindex
  ? null
  : buildGraph([...buildIdentityGraph(siteUrl, lang), ...jsonLd]);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Carlos Hernández - CHRod Dev" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow"}
    />
    <meta name="theme-color" content="#06060c" />

    {
      /* A noindex page (404) has no stable URL of its own, so a canonical and
         hreflang set would only point crawlers at the wrong thing. */
    }
    {
      !noindex && (
        <Fragment>
          {/* Canonical */}
          <link rel="canonical" href={canonical} />

          {/* hreflang */}
          <link
            rel="alternate"
            hreflang="en"
            href={`${siteUrl}${withLocale("en", alternates.en)}`}
          />
          <link
            rel="alternate"
            hreflang="es"
            href={`${siteUrl}${withLocale("es", alternates.es)}`}
          />
          {
            /* x-default is what gets served to a visitor whose language
               matches neither locale. The site targets clients beyond LATAM,
               so that fallback is English, not Spanish. Note this is
               independent of `/`'s own Accept-Language negotiation, which
               still defaults to Spanish for visitors with no preference. */
          }
          <link
            rel="alternate"
            hreflang="x-default"
            href={`${siteUrl}${withLocale("en", alternates.en)}`}
          />
        </Fragment>
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="CHRod Dev - Web Developer" />
    <meta property="og:site_name" content="CHRod Dev" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/chrod-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>

    {
      graph && (
        <script type="application/ld+json" is:inline set:html={graph} />
      )
    }
    {
      /* `data-auto-pageview`, NOT `data-auto-track`. They are different flags
         in Umami's script: `auto-pageview` stops it sending pageviews itself,
         which is what we want since `trackPageview` sends them from
         `astro:page-load`. `auto-track` additionally skips patching
         `pushState`, which freezes the URL the payload reports at whatever
         page first loaded the script, so every event after a client-side
         navigation gets filed under the wrong page. See src/lib/analytics.ts,
         which also overrides the url explicitly so this cannot regress.

         `data-exclude-hash` keeps Umami's own idea of the URL in step with
         the one we send, which already drops the hash: it folds the hash into
         the stored path, so a CTA jumping to `#service-quote-form` would
         split the page into two rows. */
    }
    {
      trackAnalytics && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id={umamiWebsiteId}
          data-auto-pageview="false"
          data-exclude-hash="true"
        />
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="bg-[#06060c] text-slate-200 antialiased">
    <slot />

    <!-- WhatsApp floating button -->
    {showWhatsAppButton && <WhatsAppButton lang={lang} />}

    <script>
      import {
        EVENTS,
        applyTrackingToggle,
        readLocation,
        track,
        trackPageview,
      } from "../lib/analytics";

      // One pageview per page view, including client-side navigations. The
      // toggle runs first so that landing on `?umami=off` opts the browser
      // out before its own arrival is counted.
      document.addEventListener("astro:page-load", () => {
        applyTrackingToggle();
        trackPageview();
      });

      // Event delegation: works for every contact-drawer trigger button,
      // including ones swapped in by future View Transitions navigations.
      document.addEventListener("click", (e) => {
        const trigger = (e.target as HTMLElement).closest(
          "[data-open-contact]",
        );
        if (trigger) {
          const location = readLocation(trigger);
          track(EVENTS.contactOpen, { location });
          // The location rides along so the drawer can report it on submit.
          // Without it only opens are attributable, and a CTA that opens the
          // drawer often but never gets sent looks identical to one that
          // converts, which is the question this is all for.
          document.dispatchEvent(
            new CustomEvent("open-contact-drawer", { detail: { location } }),
          );
        }
      });

      // Every WhatsApp link on the site, wherever it is and however it was
      // built, so a new one is tracked without being wired up by hand. The
      // listener is passive: the navigation is never delayed or intercepted,
      // and a dropped beacon costs a data point, not a conversation.
      document.addEventListener("click", (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
          'a[href*="wa.me/"]',
        );
        if (link) {
          track(EVENTS.whatsappClick, { location: readLocation(link) });
        }
      });

      // The service pages' CTAs jump to the quote form instead of opening the
      // drawer, so they need their own listener to be measurable at all.
      document.addEventListener("click", (e) => {
        const jump = (e.target as HTMLElement).closest<HTMLAnchorElement>(
          'a[href="#service-quote-form"]',
        );
        if (jump) {
          track(EVENTS.quoteFormOpen, { location: readLocation(jump) });
        }
      });

      // Close the mobile nav menu whenever the drawer opens (fresh DOM
      // query each time, so it always targets the current page's menu).
      document.addEventListener("open-contact-drawer", () => {
        document.getElementById("mobile-menu")?.classList.add("hidden");
        document.getElementById("icon-menu")?.classList.remove("hidden");
        document.getElementById("icon-close")?.classList.add("hidden");
        document
          .getElementById("mobile-menu-toggle")
          ?.setAttribute("aria-expanded", "false");
      });
    </script>

    <script>
      function initScrollAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;

              if (el.hasAttribute("data-count-to")) {
                const target = parseInt(
                  el.getAttribute("data-count-to") || "0",
                  10,
                );
                const suffix = el.getAttribute("data-count-suffix") || "";
                const duration = 1200;
                const start = performance.now();

                const step = (now: number) => {
                  const progress = Math.min((now - start) / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 3);
                  el.textContent = `${Math.round(eased * target)}${suffix}`;
                  if (progress < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
              } else {
                const animationType =
                  el.getAttribute("data-scroll-animate") || "up";
                const animationMap: Record<string, string> = {
                  up: "animate-in-up",
                  left: "animate-in-left",
                  right: "animate-in-right",
                  scale: "animate-in-scale",
                };
                const animClass =
                  animationMap[animationType] || "animate-in-up";
                el.classList.add(animClass);
              }

              observer.unobserve(el);
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px",
          },
        );

        document
          .querySelectorAll("[data-scroll-animate], [data-count-to]")
          .forEach((el) => {
            observer.observe(el);
          });
      }

      // Initialize on page load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollAnimations);
      } else {
        initScrollAnimations();
      }

      // Re-initialize after View Transitions navigation
      document.addEventListener("astro:after-swap", initScrollAnimations);
    </script>
  </body>
</html>
