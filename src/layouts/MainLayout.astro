---
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import WhatsAppButton from "../components/ui/WhatsAppButton.astro";
import "../styles/global.css";
import type { Locale } from "../i18n/ui";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  lang?: Locale;
  canonicalUrl?: string;
  alternatePath?: string;
  showWhatsAppButton?: boolean;
}

const {
  title = "CHRod - Web Developer",
  description = "Full-stack web developer specializing in React, Node.js & modern web technologies. Available for freelance projects. Landing pages, web apps, e-commerce & API development.",
  keywords = "web developer, full-stack developer, React, Node.js, freelance, portfolio, landing pages, web apps, e-commerce",
  lang = "en",
  canonicalUrl,
  alternatePath = "/",
  showWhatsAppButton = true,
} = Astro.props;

const siteUrl = "https://chrod.dev";
const canonical = canonicalUrl ?? `${siteUrl}${Astro.url.pathname}`;
const ogImage = `${siteUrl}/og-image.png`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Carlos Hernández - CHRod" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#06060c" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    <link
      rel="alternate"
      hreflang="en"
      href={`${siteUrl}${getRelativeLocaleUrl("en", alternatePath)}`}
    />
    <link
      rel="alternate"
      hreflang="es"
      href={`${siteUrl}${getRelativeLocaleUrl("es", alternatePath)}`}
    />
    <link
      rel="alternate"
      hreflang="x-default"
      href={`${siteUrl}${getRelativeLocaleUrl("es", alternatePath)}`}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="CHRod - Web Developer" />
    <meta property="og:site_name" content="CHRod" />
    <meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/chrod-logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="bg-[#06060c] text-slate-200 antialiased">
    <slot />

    <!-- WhatsApp floating button -->
    {showWhatsAppButton && <WhatsAppButton lang={lang} />}

    <script>
      // Event delegation: works for every contact-drawer trigger button,
      // including ones swapped in by future View Transitions navigations.
      document.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).closest("[data-open-contact]")) {
          document.dispatchEvent(new CustomEvent("open-contact-drawer"));
        }
      });

      // Close the mobile nav menu whenever the drawer opens (fresh DOM
      // query each time, so it always targets the current page's menu).
      document.addEventListener("open-contact-drawer", () => {
        document.getElementById("mobile-menu")?.classList.add("hidden");
        document.getElementById("icon-menu")?.classList.remove("hidden");
        document.getElementById("icon-close")?.classList.add("hidden");
        document
          .getElementById("mobile-menu-toggle")
          ?.setAttribute("aria-expanded", "false");
      });
    </script>

    <script>
      function initScrollAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;

              if (el.hasAttribute("data-count-to")) {
                const target = parseInt(
                  el.getAttribute("data-count-to") || "0",
                  10,
                );
                const suffix = el.getAttribute("data-count-suffix") || "";
                const duration = 1200;
                const start = performance.now();

                const step = (now: number) => {
                  const progress = Math.min((now - start) / duration, 1);
                  const eased = 1 - Math.pow(1 - progress, 3);
                  el.textContent = `${Math.round(eased * target)}${suffix}`;
                  if (progress < 1) requestAnimationFrame(step);
                };
                requestAnimationFrame(step);
              } else {
                const animationType =
                  el.getAttribute("data-scroll-animate") || "up";
                const animationMap: Record<string, string> = {
                  up: "animate-in-up",
                  left: "animate-in-left",
                  right: "animate-in-right",
                  scale: "animate-in-scale",
                };
                const animClass =
                  animationMap[animationType] || "animate-in-up";
                el.classList.add(animClass);
              }

              observer.unobserve(el);
            });
          },
          {
            threshold: 0.1,
            rootMargin: "0px 0px -50px 0px",
          },
        );

        document
          .querySelectorAll("[data-scroll-animate], [data-count-to]")
          .forEach((el) => {
            observer.observe(el);
          });
      }

      // Initialize on page load
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollAnimations);
      } else {
        initScrollAnimations();
      }

      // Re-initialize after View Transitions navigation
      document.addEventListener("astro:after-swap", initScrollAnimations);
    </script>
  </body>
</html>
