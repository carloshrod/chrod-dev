---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { services } from "../../../data/services";
import { servicesOverview } from "../../../data/servicesOverview";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = services.map((service) => ({
  service,
  overview: servicesOverview.find((entry) => entry.slug === service.slug)!,
}));
---

<section class="py-16">
  <Container>
    <h2
      class="mb-8 text-center text-2xl font-bold text-slate-100 sm:text-3xl"
      data-scroll-animate="up"
    >
      {t("servicesOverview.grid.heading")}
    </h2>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map(({ service, overview }, index) => (
          <a
            href={getRelativeLocaleUrl(lang, `/services/${service.slug}`)}
            class="group relative flex h-full flex-col rounded-2xl border border-border bg-surface p-7 transition-all duration-300 hover:border-red-600/50 hover:bg-surface/80"
            data-scroll-animate={`${index <= 2 ? "right" : "left"}`}
          >
            {/* Glow on hover */}
            <div
              class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              style="background: radial-gradient(circle at top left, rgba(220,38,38,0.07), transparent 70%);"
              aria-hidden="true"
            />

            {/* Icon + title */}
            <div class="mb-4 flex items-center gap-3">
              <div class="flex shrink-0 items-center justify-center rounded-xl border border-border bg-background p-3 text-red-400 transition-colors duration-300 group-hover:border-red-600/40 group-hover:text-red-300">
                <Fragment set:html={service.icon} />
              </div>
              <h3 class="text-base font-semibold text-slate-100">
                {service.card.title[lang]}
              </h3>
            </div>

            {/* Text */}
            <p class="text-sm leading-relaxed text-slate-400">
              {overview.useCase[lang]}
            </p>
            <p class="mb-4 text-xs leading-relaxed text-slate-500">
              {overview.idealFor[lang]}
            </p>

            {/* Discreet, always-visible affordance that the card is clickable */}
            <span class="mt-auto inline-flex items-center gap-1 text-xs font-medium text-slate-500 transition-colors duration-300 group-hover:text-red-400">
              {t("servicesOverview.grid.cta")}
              <svg
                class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
