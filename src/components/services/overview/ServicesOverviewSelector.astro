---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { pillars } from "../../../data/pillars";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Three pillars, not seven services. Seven is prime, so no grid divides it
// evenly and the odd one out always had to be stretched or centred. More to
// the point, "what do you need?" is a high level question, and answering it
// with seven specific options is the problem the restructure set out to fix.
---

<section class="py-16">
  <Container>
    <h2
      class="mb-8 text-center text-2xl font-bold text-slate-100 sm:text-3xl"
      data-scroll-animate="up"
    >
      {t("servicesOverview.selector.heading")}
    </h2>
    <div class="mx-auto flex max-w-4xl flex-wrap justify-center gap-3">
      {
        pillars.map((pillar, index) => (
          /* A real anchor, so the jump still works with JS off and from the
             keyboard. The script below takes over to add the highlight. */
          <a
            href={`#pillar-${pillar.id}`}
            data-pillar-jump={pillar.id}
            class="group inline-flex items-center gap-2.5 rounded-full border border-border bg-surface px-5 py-2.5 text-sm font-medium text-slate-300 transition-all hover:border-red-600/50 hover:text-slate-100"
            data-scroll-animate={index === 0 ? "left" : index === 1 ? "up" : "right"}
          >
            <span
              class="inline-flex shrink-0 text-red-400 transition-colors group-hover:text-red-300 [&_svg]:size-4"
              aria-hidden="true"
              set:html={pillar.selectorIcon}
            />
            {pillar.selectorLabel[lang]}
          </a>
        ))
      }
    </div>
  </Container>
</section>

<script>
  // Grid cards use [data-scroll-animate] + an IntersectionObserver (see
  // MainLayout.astro) that fades them in via a CSS `animation` the first
  // time they cross into view. scrollIntoView() below causes that same
  // observer to fire for the target card mid-highlight, and a CSS
  // `animation` always wins over inline styles/transitions for the
  // properties it drives — so the entrance fade would silently replace
  // our highlight. ensureRevealed() permanently disables that entrance
  // animation per-card (once) and snaps it to its final visible state, so
  // our own inline-style-driven highlight/dim never races against it. The
  // pulse itself runs via the Web Animations API, which lives outside the
  // CSS `animation` cascade entirely and so can never collide either.
  const HIGHLIGHT_MS = 2600;
  const STAGGER_MS = 80;
  let highlightTimeout: ReturnType<typeof setTimeout> | undefined;

  function ensureRevealed(el: HTMLElement) {
    if (el.dataset.jumpRevealed) return;
    el.dataset.jumpRevealed = "true";
    el.style.setProperty("animation", "none", "important");
    el.style.opacity = "1";
    el.style.transform = "none";
  }

  function clearHighlight() {
    document
      .querySelectorAll<HTMLElement>("[data-pillar-header]")
      .forEach((el) => {
        el.style.opacity = "1";
        el.style.transitionDelay = "";
      });

    document
      .querySelectorAll<HTMLElement>("[data-service-card]")
      .forEach((el) => {
        el.getAnimations().forEach((anim) => anim.cancel());
        el.style.opacity = "1";
        el.style.transform = "none";
        el.style.borderColor = "";
        el.style.boxShadow = "";
        el.style.position = "";
        el.style.zIndex = "";
        el.style.transitionDelay = "";
      });
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>(
      "[data-pillar-jump]",
    );
    if (!trigger) return;

    const pillarId = trigger.getAttribute("data-pillar-jump");
    const group = document.getElementById(`pillar-${pillarId}`);
    if (!group) return;

    const targets = Array.from(
      document.querySelectorAll<HTMLElement>(`[data-pillar="${pillarId}"]`),
    );
    if (targets.length === 0) return;

    e.preventDefault();

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-service-card]"),
    );
    cards.forEach(ensureRevealed);

    clearTimeout(highlightTimeout);
    clearHighlight();

    // Scrolls to the group, not to a single card, so the pillar heading and
    // all of its services land in view together.
    group.scrollIntoView({ behavior: "smooth", block: "start" });
    // Safari/WebKit focuses focusable elements as a side effect of
    // scrollIntoView() (unlike Chrome/Firefox), which draws the browser's
    // default blue focus ring on top of our red highlight. Blur it since
    // this focus wasn't a real keyboard/user focus interaction.
    targets.forEach((el) => el.blur());

    // The heading of a dimmed group reads as active if it stays at full
    // opacity, so the headers follow their cards.
    document
      .querySelectorAll<HTMLElement>("[data-pillar-header]")
      .forEach((el) => {
        ensureRevealed(el);
        el.style.opacity =
          el.getAttribute("data-pillar-header") === pillarId ? "1" : "0.32";
      });

    cards.forEach((el) => {
      const position = targets.indexOf(el);
      if (position !== -1) {
        el.style.position = "relative";
        el.style.zIndex = "10";
        el.style.borderColor = "rgba(220, 38, 38, 0.85)";
        el.style.transform = "translateY(-6px) scale(1.035)";
        // Staggered rather than simultaneous: two or three cards lifting at
        // once is a lot of motion, and the sweep reads as "these belong
        // together" instead of a flash.
        el.style.transitionDelay = `${position * STAGGER_MS}ms`;
        el.animate(
          [
            {
              boxShadow:
                "0 0 0 3px rgba(220,38,38,0.25), 0 18px 40px rgba(220,38,38,0.16)",
            },
            {
              boxShadow:
                "0 0 0 7px rgba(220,38,38,0.12), 0 22px 55px rgba(220,38,38,0.26)",
            },
            {
              boxShadow:
                "0 0 0 3px rgba(220,38,38,0.25), 0 18px 40px rgba(220,38,38,0.16)",
            },
          ],
          {
            duration: HIGHLIGHT_MS / 2,
            iterations: 2,
            easing: "ease-in-out",
            delay: position * STAGGER_MS,
          },
        );
      } else {
        el.style.opacity = "0.32";
        el.style.transform = "scale(0.98)";
      }
    });

    highlightTimeout = setTimeout(clearHighlight, HIGHLIGHT_MS);
  });
</script>

<style is:global>
  [data-service-card],
  [data-pillar-header] {
    transition:
      border-color 0.3s ease,
      opacity 0.35s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
</style>
