---
import Container from "../../layout/Container.astro";
import Breadcrumbs from "../../ui/Breadcrumbs.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden pb-16 pt-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-125 w-150 -translate-x-1/2 -translate-y-1/3"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at center, rgba(220,38,38,0.1) 0%, rgba(220,38,38,0.04) 40%, transparent 70%);"
  >
  </div>
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h1
        class="mb-4 text-4xl font-bold leading-tight text-slate-100 sm:text-5xl"
        data-scroll-animate="up"
      >
        {t("servicesOverview.hero.heading")}
      </h1>
      <p
        class="text-lg leading-relaxed text-slate-400"
        data-scroll-animate="up"
      >
        {t("servicesOverview.hero.subheading")}
      </p>
    </div>
  </Container>
</section>
