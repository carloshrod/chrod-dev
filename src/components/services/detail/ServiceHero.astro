---
import Container from "../../layout/Container.astro";
import Breadcrumbs from "../../ui/Breadcrumbs.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { getRouteUrl } from "../../../i18n/routes";
import type { Service } from "../../../data/services/types";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
const servicesUrl = getRouteUrl(lang, "services");
const ctaLabel = service.hero.ctaLabel?.[lang] ?? t("service.page.hero.cta");
---

<section id="service-hero" class="relative overflow-hidden pb-16 pt-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-125 w-150 -translate-x-1/2 -translate-y-1/3"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at center, rgba(220,38,38,0.1) 0%, rgba(220,38,38,0.04) 40%, transparent 70%);"
  >
  </div>
  <Container>
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t("nav.services"), href: servicesUrl },
        { label: service.card.title[lang], icon: service.icon },
      ]}
    />

    <div class="max-w-3xl">
      <h1
        class="mb-5 text-4xl font-bold leading-tight text-slate-100 sm:text-5xl"
      >
        {service.hero.headline[lang]}
      </h1>
      <p class="mb-8 text-lg leading-relaxed text-slate-400">
        {service.hero.subheadline[lang]}
      </p>
      <a
        href="#service-quote-form"
        data-wiggle-trigger
        class="inline-flex rounded-lg bg-red-600 px-7 py-3 text-sm font-semibold text-white transition-all hover:bg-red-500 active:scale-95"
      >
        {ctaLabel}
      </a>
      <p class="mt-3 text-xs text-slate-500">
        {t("service.page.hero.microcopy")}
      </p>
    </div>
  </Container>
</section>
