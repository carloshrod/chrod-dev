---
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  id="service-sticky-cta"
  class="pointer-events-none fixed bottom-4 right-4 z-60 translate-y-4 opacity-0 transition-all duration-300 sm:bottom-6 sm:right-6"
>
  <a
    href="#service-quote-form"
    data-wiggle-trigger
    class="flex items-center justify-center gap-2 rounded-full bg-red-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-black/40 transition-all hover:bg-red-500 sm:px-7 sm:py-3.5"
  >
    {t("service.page.sticky.cta")}
  </a>
</div>

<script>
  // Re-run on the initial load and after every View Transitions navigation,
  // since the DOM elements below get replaced on each page swap.
  let stickyCtaObserver: IntersectionObserver | undefined;

  function initServiceStickyCta() {
    stickyCtaObserver?.disconnect();

    const stickyCta = document.getElementById("service-sticky-cta");
    const heroCta = document.querySelector<HTMLElement>(
      "#service-hero [data-wiggle-trigger]",
    );
    const quoteForm = document.getElementById("service-quote-form");
    if (!stickyCta || !heroCta || !quoteForm) return;

    const setVisible = (visible: boolean) => {
      stickyCta.classList.toggle("opacity-0", !visible);
      stickyCta.classList.toggle("translate-y-4", !visible);
      stickyCta.classList.toggle("pointer-events-none", !visible);
    };

    let heroCtaVisible = true;
    let quoteFormVisible = false;

    stickyCtaObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target === heroCta) heroCtaVisible = entry.isIntersecting;
          if (entry.target === quoteForm) quoteFormVisible = entry.isIntersecting;
        });
        setVisible(!heroCtaVisible && !quoteFormVisible);
      },
      { rootMargin: "-96px 0px 0px 0px" },
    );

    stickyCtaObserver.observe(heroCta);
    stickyCtaObserver.observe(quoteForm);
  }

  document.addEventListener("astro:page-load", initServiceStickyCta);
</script>
