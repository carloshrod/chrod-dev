---
import Container from "../../layout/Container.astro";
import FaqItem from "../../ui/FaqItem.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Service } from "../../../data/services/types";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20">
  <Container>
    <h2 class="mb-10 text-center text-3xl font-bold text-slate-100 sm:text-4xl" data-scroll-animate="up">
      {t("service.page.faq.heading")}
    </h2>

    <div class="mx-auto max-w-2xl space-y-3">
      {
        service.faq.map((item) => (
          <FaqItem
            question={item.question[lang]}
            answer={item.answer[lang]}
            animate
          />
        ))
      }
    </div>
  </Container>
</section>
