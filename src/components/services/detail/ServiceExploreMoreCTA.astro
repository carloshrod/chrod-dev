---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const servicesUrl = getRelativeLocaleUrl(lang, "/services");
---

<section class="border-t border-border py-16">
  <Container>
    <div class="mx-auto flex max-w-xl flex-col items-center gap-4 text-center">
      <p class="text-lg text-slate-300" data-scroll-animate="up">
        {t("service.page.exploreMore.heading")}
      </p>
      <a
        href={servicesUrl}
        class="inline-flex rounded-lg border border-border bg-surface px-7 py-3 text-sm font-semibold text-slate-200 transition-all hover:border-red-400 hover:text-red-400"
        data-scroll-animate="up"
      >
        {t("service.page.backToServices")}
      </a>
    </div>
  </Container>
</section>
