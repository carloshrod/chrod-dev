---
import MainLayout from "../../../layouts/MainLayout.astro";
import Navbar from "../../layout/Navbar.astro";
import Footer from "../../layout/Footer.astro";
import ContactDrawer from "../../ui/ContactDrawer.tsx";
import TravelingGlow from "../../ui/TravelingGlow.astro";
import ServiceHero from "./ServiceHero.astro";
import ServiceProblemSolution from "./ServiceProblemSolution.astro";
import ServiceModes from "./ServiceModes.astro";
import ServiceIncludes from "./ServiceIncludes.astro";
import ServiceProcess from "./ServiceProcess.astro";
import ServiceTechStack from "./ServiceTechStack.astro";
import ServiceRelatedProjects from "./ServiceRelatedProjects.astro";
import ServiceFAQ from "./ServiceFAQ.astro";
import ServiceRelatedPosts from "./ServiceRelatedPosts.astro";
import ServiceQuoteForm from "../form/ServiceQuoteForm.tsx";
import ServiceExploreMoreCTA from "./ServiceExploreMoreCTA.astro";
import ServiceStickyCTA from "./ServiceStickyCTA.astro";
import type { Locale } from "../../../i18n/ui";
import { getAlternatePaths, getRouteUrl } from "../../../i18n/routes";
import { useTranslations } from "../../../i18n/utils";
import type { Service } from "../../../data/services/types";
import { getPillarForService } from "../../../data/pillars";
import { getPosts, getProjects } from "../../../lib/sanity";
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
  getSiteUrl,
  type BreadcrumbItem,
  type JsonLd,
} from "../../../lib/schema";

interface Props {
  service: Service;
  lang: Locale;
}

const { service, lang } = Astro.props;
const alternates = getAlternatePaths("services", service.slug);

const t = useTranslations(lang);
const siteUrl = getSiteUrl(Astro.site);
const servicePath = getRouteUrl(lang, "services", service.slug[lang]);

// Defined once, then handed to both ServiceHero (rendered nav) and the
// BreadcrumbList markup, so the two cannot drift apart.
// The pillar is NOT in the trail. It lives at /solutions/<slug>/ now, so
// putting it between "Services" and this page would describe a hierarchy the
// URL does not have. The pillar stays reachable through the line below the
// heading, the grouped overview and the home cards.
const pillar = getPillarForService(service.id);

const crumbs: BreadcrumbItem[] = [
  { label: t("nav.services"), href: getRouteUrl(lang, "services") },
  { label: service.card.title[lang], icon: service.icon },
];

const jsonLd: JsonLd[] = [
  buildBreadcrumbSchema(
    siteUrl,
    t("breadcrumb.home"),
    getRouteUrl(lang, "home"),
    crumbs,
  ),
  buildServiceSchema(siteUrl, lang, service, servicePath),
];

const faqSchema = buildFaqSchema(lang, service);
if (faqSchema) jsonLd.push(faqSchema);

// Fetched here rather than inside their sections: whether those sections
// render decides the background of every section after them (see below).
const relatedProjects = (await getProjects(lang))
  .filter((project) => project.services?.includes(service.id))
  .slice(0, 3);
// A post lists its main service first, so posts where this service comes
// earlier rank higher; ties keep getPosts' newest-first order (sort is
// stable). A failed fetch means no articles, not a broken service page.
const relatedPosts = await getPosts(lang)
  .then((all) =>
    all
      .filter((p) => p.services.includes(service.id))
      .sort((a, b) => a.services.indexOf(service.id) - b.services.indexOf(service.id))
      .slice(0, 3),
  )
  .catch(() => []);

// Section backgrounds alternate by position among the sections that actually
// render, starting with the one under the hero. Each section used to carry
// its own fixed colour, which only worked while every service had the same
// sections: WhatsApp's extra "modes" block, or a service with no related
// projects, put two dark sections back to back. The closing block (related
// articles, then "explore other services") takes the opposite of the form,
// so the two read as one ending.
const order = [
  "problem",
  service.modes && "modes",
  "includes",
  "process",
  "tech",
  relatedProjects.length > 0 && "projects",
  "faq",
  "form",
].filter(Boolean) as string[];
const alt = (key: string) => order.indexOf(key) % 2 === 0;
const closingAlt = !alt("form");
---

<MainLayout
  lang={lang}
  title={service.seo.title[lang]}
  description={service.seo.description[lang]}
  alternates={alternates}
  showWhatsAppButton={false}
  jsonLd={jsonLd}
>
  <Navbar lang={lang} alternates={alternates} />
  <main>
    <TravelingGlow>
      <ServiceHero
        service={service}
        lang={lang}
        crumbs={crumbs}
        pillar={pillar}
      />
      <ServiceProblemSolution service={service} lang={lang} alt={alt("problem")} />
      <ServiceModes service={service} lang={lang} alt={alt("modes")} />
      <ServiceIncludes service={service} lang={lang} alt={alt("includes")} />
      <ServiceProcess service={service} lang={lang} alt={alt("process")} />
      <ServiceTechStack service={service} lang={lang} alt={alt("tech")} />
      <ServiceRelatedProjects projects={relatedProjects} lang={lang} alt={alt("projects")} />
      <ServiceFAQ service={service} lang={lang} alt={alt("faq")} />
      <ServiceQuoteForm service={service} lang={lang} alt={alt("form")} client:load />
      <ServiceRelatedPosts posts={relatedPosts} lang={lang} alt={closingAlt} />
      <ServiceExploreMoreCTA lang={lang} alt={closingAlt} />
    </TravelingGlow>
  </main>
  <Footer lang={lang} />
  <ServiceStickyCTA lang={lang} />
  <ContactDrawer client:load lang={lang} />
</MainLayout>
