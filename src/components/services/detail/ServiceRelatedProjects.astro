---
import Container from "../../layout/Container.astro";
import ProjectCardLink from "../../ui/ProjectCardLink.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Project } from "../../../types/project";

interface Props {
  /** Already filtered and capped by ServicePage, which needs to know whether
   * this section renders before it can alternate the backgrounds. */
  projects: Project[];
  lang: Locale;
  /** Background tone, assigned by ServicePage from the section's position. */
  alt?: boolean;
}

const { projects, lang, alt = false } = Astro.props;
const t = useTranslations(lang);
---

{
  projects.length > 0 && (
    <section class:list={["py-20", alt && "bg-surface-alt"]}>
      <Container>
        <h2
          class="mb-10 text-center text-3xl font-bold text-slate-100 sm:text-4xl"
          data-scroll-animate="up"
        >
          {t("service.page.related.heading")}
        </h2>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, index) => (
            <ProjectCardLink project={project} lang={lang} index={index} />
          ))}
        </div>
      </Container>
    </section>
  )
}
