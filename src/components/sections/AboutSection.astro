---
import Container from "../layout/Container.astro";
import Icon from "../ui/icons.astro";
import { STATS } from "../../data/stats";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { getRouteUrl } from "../../i18n/routes";

const { lang = "en" } = Astro.props as { lang?: Locale };
const t = useTranslations(lang);
const aboutUrl = getRouteUrl(lang, "about");
---

<section id="about" class="py-24 bg-surface-alt">
  <Container>
    <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
      <!-- Text -->
      <div>
        <h2
          class="mb-6 text-3xl font-bold text-slate-100 sm:text-4xl"
          data-scroll-animate="left"
        >
          {t("about.heading")}
        </h2>
        <div
          class="space-y-4 leading-relaxed text-slate-400"
          data-scroll-animate="left"
        >
          <p>{t("about.p1")}</p>
          <p>{t("about.p2")}</p>
        </div>

        {/* What I build, as a fixed list. It used to be a typing animation
            cycling through phrases: one line visible at a time, never read
            in full, and JavaScript only to decorate text. Chatbots and AI
            agents are named outright because that is what people search for;
            they were implied under "automation" before. */}
        <div class="mt-8" data-scroll-animate="left">
          <p class="mb-3 text-sm uppercase tracking-wide text-slate-500">
            {t("about.build.intro")}
          </p>
          <ul class="space-y-1.5">
            {
              ["about.build.1", "about.build.2", "about.build.3", "about.build.4"].map((key) => (
                <li class="flex items-baseline gap-2.5 text-lg font-semibold text-slate-100">
                  <span class="text-slate-500" aria-hidden="true">›</span>
                  {t(key)}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="mt-10 flex flex-wrap justify-center gap-10 text-sm"
          data-scroll-animate="left"
        >
          {
            STATS.map((stat) => (
              <div>
                <p class="text-3xl font-bold text-slate-100" data-count-to={stat.value}>
                  {stat.value}
                </p>
                <p class="mt-1 text-slate-500">{t(stat.labelKey)}</p>
              </div>
            ))
          }
</div>

        <div class="max-[1121px]:flex max-[1121px]:justify-center">
          <a
            href={aboutUrl}
            class="mt-8 inline-flex items-center gap-2 rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-slate-200 transition-all hover:border-red-400 hover:text-red-300"
            data-scroll-animate="left"
          >
            {t("about.cta.learnMore")}
            <Icon name="arrowRight" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>

      <!-- Code card -->
      <div
        class="relative mx-auto w-full max-w-sm lg:mx-0"
        data-scroll-animate="right"
      >
        <div
          class="absolute inset-0 rounded-2xl bg-red-600/15 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-2xl border border-border bg-surface p-8"
        >
          <!-- Fake window chrome -->
          <div class="mb-6 flex items-center gap-3">
            <div class="flex gap-1.5">
              <span class="h-3 w-3 rounded-full bg-red-500/60"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-500/60"></span>
              <span class="h-3 w-3 rounded-full bg-green-500/60"></span>
            </div>
            <span class="text-xs text-slate-600">about.ts</span>
          </div>

          <pre
            class="overflow-x-auto text-sm leading-7"><code><span class="text-slate-500">// about.ts</span>
<span class="text-red-400">const</span> <span class="text-slate-200">developer</span> = &#123;
  <span class="text-emerald-400">name</span>: <span class="text-amber-300">"Carlos Hernández"</span>,
  <span class="text-emerald-400">role</span>: <span class="text-amber-300">"Full Stack Dev"</span>,
  <span class="text-emerald-400">location</span>: <span class="text-amber-300">"Remote 🌍"</span>,
  <span class="text-emerald-400">available</span>: <span class="text-red-400">true</span>,
  <span class="text-emerald-400">focus</span>: [
    <span class="text-amber-300">"React"</span>, <span class="text-amber-300">"Next.js"</span>, <span class="text-amber-300">"Astro"</span>,
    <span class="text-amber-300">"JavaScript"</span>, <span class="text-amber-300">"TypeScript"</span>,
    <span class="text-amber-300">"Node.js"</span>, <span class="text-amber-300">"Express.js"</span>,
  ],
&#125;;</code></pre>
        </div>
      </div>
    </div>
  </Container>
</section>
