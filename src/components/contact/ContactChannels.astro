---
import Icon from "../ui/icons.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const EMAIL = "hello@chrod.dev";

/**
 * The two direct channels, plus how fast a reply comes.
 *
 * The response time is not decoration: a form with no stated turnaround reads
 * as a mailbox nobody checks, and it is the cheapest thing on the page that
 * makes writing feel worth it. It repeats the promise `drawer.form.intro`
 * already makes, deliberately, so the two cannot say different numbers.
 */
---

<div class="space-y-4">
  <h2 class="text-lg font-semibold text-slate-100">
    {t("contact.page.channels.heading")}
  </h2>

  <a
    href={buildWhatsAppUrl()}
    target="_blank"
    rel="noopener noreferrer"
    data-analytics-location="contact_page"
    class="group flex items-start gap-4 rounded-xl border border-border bg-surface p-5 transition-all hover:border-emerald-500/50"
  >
    <span
      class="mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10 text-emerald-400"
    >
      <Icon name="whatsapp" />
    </span>
    <span class="min-w-0">
      <span class="block text-sm font-semibold text-slate-200">
        {t("contact.page.channels.whatsapp")}
      </span>
      <span class="mt-1 block text-xs text-slate-500">
        {t("contact.page.channels.whatsapp.note")}
      </span>
    </span>
  </a>

  <a
    href={`mailto:${EMAIL}`}
    class="group flex items-start gap-4 rounded-xl border border-border bg-surface p-5 transition-all hover:border-slate-500"
  >
    <span
      class="mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-slate-500/10 text-slate-300"
    >
      <Icon name="mail" />
    </span>
    <span class="min-w-0">
      <span class="block text-sm font-semibold text-slate-200">
        {t("contact.page.channels.email")}
      </span>
      <span class="mt-1 block truncate text-xs text-slate-500">
        {EMAIL}
      </span>
    </span>
  </a>

  <p class="pt-1 text-xs text-slate-500">
    {t("contact.page.response")}
  </p>
</div>
