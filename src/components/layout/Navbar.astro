---
import { Image } from "astro:assets";
import logo from "../../assets/chrod-logo.png";
import Container from "./Container.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import {
  getAlternatePaths,
  getRouteUrl,
  isRouteActive,
  stripLocale,
  withLocale,
  type AlternatePaths,
} from "../../i18n/routes";
import Icon from "../ui/icons.astro";

interface Props {
  lang?: Locale;
  /** This page's unprefixed path in each language, for the language switcher. */
  alternates?: AlternatePaths;
}

const { lang = "en", alternates = getAlternatePaths("home") } =
  Astro.props as Props;
const t = useTranslations(lang);
const homeUrl = getRouteUrl(lang, "home");
const currentPath = stripLocale(Astro.url.pathname);

// The two languages use different URL segments, so the switcher can't reuse
// the current path — each page hands down its counterpart via `alternates`.
const enUrl = withLocale("en", alternates.en);
const esUrl = withLocale("es", alternates.es);

interface NavLink {
  label: string;
  href: string;
  active: boolean;
}

const navLinks: NavLink[] = [
  {
    label: t("nav.services"),
    href: getRouteUrl(lang, "services"),
    active: isRouteActive(currentPath, lang, "services"),
  },
  {
    label: t("nav.projects"),
    href: getRouteUrl(lang, "projects"),
    active: isRouteActive(currentPath, lang, "projects"),
  },
  {
    label: t("nav.about"),
    href: getRouteUrl(lang, "about"),
    active: isRouteActive(currentPath, lang, "about"),
  },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border bg-[#080808]/80 backdrop-blur-md"
>
  <Container>
    <nav class="grid h-16 grid-cols-[auto_1fr_auto] items-center">
      <a
        href={homeUrl}
        id="navbar-logo-link"
        class="flex items-center gap-2"
        aria-label="Home"
      >
        <Image
          src={logo}
          alt="chrod logo"
          loading="eager"
          class="h-10 w-auto"
        />
      </a>

      <!-- Desktop nav links (centered) -->
      <ul class="hidden items-center justify-center gap-8 md:flex">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`text-sm font-medium transition-colors hover:text-red-400 active:text-red-400 ${
                  link.active ? "text-red-400" : "text-slate-400"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- Desktop right: lang switcher + contact -->
      <div class="hidden items-center gap-3 md:flex">
        <div
          class="flex items-center rounded-full border border-border bg-surface-alt text-xs font-semibold overflow-hidden"
        >
          <a
            href={esUrl}
            data-lang-link="es"
            class={`px-3 py-1 transition-colors ${
              lang === "es"
                ? "bg-surface-raised text-red-400"
                : "text-slate-400 hover:text-slate-200"
            }`}
            aria-label="Cambiar a Español">ES</a
          >
          <a
            href={enUrl}
            data-lang-link="en"
            class={`px-3 py-1 transition-colors ${
              lang === "en"
                ? "bg-surface-raised text-red-400"
                : "text-slate-400 hover:text-slate-200"
            }`}
            aria-label="Switch to English">EN</a
          >
        </div>
        <button
          id="navbar-contact-btn"
          data-open-contact
          data-wiggle-trigger
          class="rounded-lg border border-red-600/50 px-4 py-1.5 text-sm font-medium text-red-400 transition-all hover:border-red-400 hover:text-red-300 cursor-pointer"
        >
          {t("nav.contact")}
        </button>
      </div>

      <!-- Mobile right: lang switcher + hamburger -->
      <div class="flex justify-end items-center gap-3 md:hidden">
        <div
          class="flex items-center rounded-full border border-border bg-surface-alt text-xs font-semibold overflow-hidden"
        >
          <a
            href={esUrl}
            data-lang-link="es"
            class={`px-3 py-1 transition-colors ${
              lang === "es"
                ? "bg-surface-raised text-red-400"
                : "text-slate-400 hover:text-slate-200"
            }`}
            aria-label="Cambiar a Español">ES</a
          >
          <a
            href={enUrl}
            data-lang-link="en"
            class={`px-3 py-1 transition-colors ${
              lang === "en"
                ? "bg-surface-raised text-red-400"
                : "text-slate-400 hover:text-slate-200"
            }`}
            aria-label="Switch to English">EN</a
          >
        </div>

        <!-- Mobile: hamburger -->
        <button
          id="mobile-menu-toggle"
          class="flex items-center justify-end rounded-md p-2 text-slate-400 transition-colors hover:text-red-400 cursor-pointer md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <Icon name="menu" id="icon-menu" />
          <Icon name="close" class="hidden" id="icon-close" />
        </button>
      </div>
    </nav>
  </Container>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border md:hidden">
    <Container>
      <ul class="flex flex-col gap-1 py-4">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class={`mobile-nav-link block rounded-md px-3 py-2 text-center text-sm font-medium transition-colors hover:bg-border hover:text-red-400 active:bg-border active:text-red-400 ${
                  link.active ? "text-red-400" : "text-slate-400"
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <div class="flex items-center">
            <button
              id="mobile-contact-btn"
              data-open-contact
              data-wiggle-trigger
              class="flex-1 rounded-lg border border-red-600/50 px-3 py-2 text-center text-sm font-medium text-red-400 transition-all hover:border-red-400 active:border-red-400 cursor-pointer"
            >
              {t("nav.contact")}
            </button>
          </div>
        </li>
      </ul>
    </Container>
  </div>
</header>

<script>
  // Re-run on the initial load and after every View Transitions navigation,
  // since the DOM elements below get replaced on each page swap.
  function initNavbar() {
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    toggle?.addEventListener("click", () => {
      const isOpen = !menu?.classList.contains("hidden");
      menu?.classList.toggle("hidden", isOpen);
      iconMenu?.classList.toggle("hidden", !isOpen);
      iconClose?.classList.toggle("hidden", isOpen);
      toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        menu?.classList.add("hidden");
        iconMenu?.classList.remove("hidden");
        iconClose?.classList.add("hidden");
        toggle?.setAttribute("aria-expanded", "false");
      });
    });

    // Logo: scroll to top without reload when already on the home page
    const logoLink = document.getElementById(
      "navbar-logo-link",
    ) as HTMLAnchorElement | null;
    logoLink?.addEventListener("click", (e) => {
      const href = logoLink.getAttribute("href");
      const normalize = (p: string) => p.replace(/\/$/, "") || "/";
      if (href && normalize(window.location.pathname) === normalize(href)) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
