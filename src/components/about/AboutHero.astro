---
import Container from "../layout/Container.astro";
import Icon from "../ui/icons.astro";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden pb-16 pt-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-125 w-150 -translate-x-1/2 -translate-y-1/3"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at center, rgba(220,38,38,0.1) 0%, rgba(220,38,38,0.04) 40%, transparent 70%);"
  >
  </div>
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h1
        class="max-w-xl mb-4 text-4xl m-auto font-bold leading-tight text-slate-100 sm:text-5xl"
        data-scroll-animate="up"
      >
        {t("about.page.hero.heading")}
      </h1>
      <p
        class="mb-8 text-lg leading-relaxed text-slate-400"
        data-scroll-animate="up"
      >
        {t("about.page.hero.subheading")}
      </p>

      <div
        class="flex flex-wrap items-center justify-center gap-4"
        data-scroll-animate="up"
      >
        <button
          data-open-contact
          data-wiggle-trigger
          class="cursor-pointer rounded-lg bg-red-600 px-7 py-3 text-sm font-semibold text-white transition-all hover:bg-red-500 active:scale-95"
        >
          {t("about.page.hero.cta.contact")}
        </button>
        <a
          href={t("about.resume.url")}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-lg border border-red-600/50 px-5 py-2.5 text-sm font-medium text-red-400 transition-all hover:border-red-400 hover:text-red-300"
        >
          <Icon name="download" />
          {t("about.resume")}
        </a>
      </div>
    </div>
  </Container>
</section>
