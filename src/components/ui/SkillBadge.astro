---
export interface Props {
  name: string;
  iconPath?: string;
  iconColor?: string;
  compact?: boolean;
}

const { name, iconPath, iconColor, compact = false } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-2 rounded-lg border border-border bg-surface font-medium text-slate-300 transition-all hover:border-red-600/40 hover:text-slate-100",
    compact ? "px-2.5 py-1 text-xs" : "px-3.5 py-2 text-sm",
  ]}
>
  {
    iconPath && (
      <svg
        role="img"
        viewBox="0 0 24 24"
        xmlns="http://www.w3.org/2000/svg"
        class:list={["shrink-0", compact ? "h-3 w-3" : "h-4 w-4"]}
        style={`fill: #${iconColor ?? "e2e8f0"};`}
        aria-hidden="true"
      >
        <path d={iconPath} />
      </svg>
    )
  }
  {name}
</span>
