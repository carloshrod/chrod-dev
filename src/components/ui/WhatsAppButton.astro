---
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import Icon from "./icons.astro";

const { lang = "en" } = Astro.props as { lang?: Locale };
const t = useTranslations(lang);
---

<a
  id="whatsapp-btn"
  href={buildWhatsAppUrl()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t("whatsapp.label")}
  class="group fixed bottom-6 right-6 z-80 flex h-14 w-14 items-center justify-center rounded-full bg-surface ring-1 ring-border shadow-lg shadow-black/50 transition-all duration-300 hover:scale-110 hover:bg-emerald-950 hover:ring-emerald-500 [&.wa-animate]:bg-emerald-950 [&.wa-animate]:ring-emerald-500"
>
  <Icon name="whatsapp" />
</a>

<script>
  // Re-query the button fresh on every trigger instead of caching it once,
  // since View Transitions replaces this element's DOM node on navigation.
  function triggerWiggle() {
    const waBtn = document.getElementById("whatsapp-btn");
    if (!waBtn) return;
    waBtn.classList.remove("wa-animate");
    void waBtn.offsetWidth; // reflow para reiniciar animación
    waBtn.classList.add("wa-animate");
    waBtn.addEventListener(
      "animationend",
      () => waBtn.classList.remove("wa-animate"),
      { once: true },
    );
  }

  // Delegation: registered once, works for any current or future button
  // marked data-wiggle-trigger, including ones swapped in after navigation.
  document.addEventListener("mouseover", (e) => {
    if ((e.target as HTMLElement).closest("[data-wiggle-trigger]")) {
      triggerWiggle();
    }
  });
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-wiggle-trigger]")) {
      triggerWiggle();
    }
  });
</script>
