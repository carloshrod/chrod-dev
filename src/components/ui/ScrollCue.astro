---
// "Explore" with a bouncing arrow, pinned to the bottom of a full-screen hero
// to say the page goes on. Used by the home, service and about heroes, which
// fill the viewport on purpose: letting the next section peek in instead was
// measured (2026-11-23) and, with service copy of different lengths, cut the
// next heading in half at the fold on 1366x768 and on phones. The parent
// section must be `relative`.
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
  class="pointer-events-none absolute inset-x-0 bottom-8 z-10 flex flex-col items-center gap-2 text-slate-600"
  aria-hidden="true"
>
  <span class="text-xs uppercase tracking-widest">{t("hero.scroll")}</span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="animate-bounce"
  >
    <path d="M12 5v14"></path>
    <path d="m19 12-7 7-7-7"></path>
  </svg>
</div>
