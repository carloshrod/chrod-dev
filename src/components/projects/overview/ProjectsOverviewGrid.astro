---
import Container from "../../layout/Container.astro";
import ProjectCardLink from "../../ui/ProjectCardLink.astro";
import Icon from "../../ui/icons.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Project } from "../../../types/project";

interface Props {
  projects: Project[];
  lang: Locale;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);

const PAGE_SIZE = 6;
const totalPages = Math.ceil(projects.length / PAGE_SIZE);

const initialEnd = Math.min(PAGE_SIZE, projects.length);
const initialStatus =
  initialEnd === 1
    ? t("projectsOverview.pagination.showingSingle")
        .replace("{n}", "1")
        .replace("{total}", String(projects.length))
    : t("projectsOverview.pagination.showing")
        .replace("{start}", "1")
        .replace("{end}", String(initialEnd))
        .replace("{total}", String(projects.length));
---

<section class="py-16">
  <Container>
    <div
      class="grid scroll-mt-28 gap-6 sm:grid-cols-2 lg:grid-cols-3"
      data-projects-grid
    >
      {
        projects.map((project, index) => (
          <div
            class="flex"
            data-project-item
            data-page={Math.floor(index / PAGE_SIZE) + 1}
            hidden={index >= PAGE_SIZE}
          >
            <ProjectCardLink
              project={project}
              lang={lang}
              index={index}
              animate
              eager={index < 3}
            />
          </div>
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <div class="mt-10 flex flex-col items-center gap-4">
          <p
            class="text-sm text-slate-500"
            data-projects-status
            aria-live="polite"
          >
            {initialStatus}
          </p>
          <nav
            aria-label={t("projectsOverview.pagination.nav")}
            class="flex items-center gap-2"
            data-projects-pagination
            data-page-size={PAGE_SIZE}
            data-total={projects.length}
            data-template={t("projectsOverview.pagination.showing")}
            data-template-single={t(
              "projectsOverview.pagination.showingSingle",
            )}
            data-page-label={t("projectsOverview.pagination.page")}
          >
            <button
              type="button"
              data-page-btn="prev"
              aria-label={t("projectsOverview.pagination.prev")}
              class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-border bg-surface text-slate-300 transition-all hover:border-red-600/50 hover:text-slate-100 disabled:cursor-not-allowed disabled:pointer-events-none disabled:opacity-40"
            >
              <Icon name="arrowLeft" class="h-3.5 w-3.5" />
            </button>
            {Array.from({ length: totalPages }).map((_, i) => (
              <button
                type="button"
                data-page-btn={i + 1}
                aria-label={t("projectsOverview.pagination.page").replace(
                  "{n}",
                  String(i + 1),
                )}
                aria-current={i === 0 ? "page" : undefined}
                class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border text-sm font-medium transition-all border-border bg-surface text-slate-300 hover:border-red-600/50 hover:text-slate-100 aria-[current=page]:border-red-600/70 aria-[current=page]:bg-red-600/10 aria-[current=page]:text-slate-100"
              >
                {i + 1}
              </button>
            ))}
            <button
              type="button"
              data-page-btn="next"
              aria-label={t("projectsOverview.pagination.next")}
              class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-border bg-surface text-slate-300 transition-all hover:border-red-600/50 hover:text-slate-100 disabled:cursor-not-allowed disabled:pointer-events-none disabled:opacity-40"
            >
              <Icon name="arrowRight" class="h-3.5 w-3.5" />
            </button>
          </nav>
        </div>
      )
    }
  </Container>
</section>

<script>
  function initProjectsPagination() {
    const pagination = document.querySelector<HTMLElement>(
      "[data-projects-pagination]",
    );
    const grid = document.querySelector<HTMLElement>("[data-projects-grid]");
    const status = document.querySelector<HTMLElement>(
      "[data-projects-status]",
    );
    if (!pagination || !grid || !status) return;

    // Guards against a duplicate click handler (and a doubled page jump on
    // the next click) if astro:page-load ever fires twice for this same DOM.
    if (pagination.dataset.paginationBound === "true") return;
    pagination.dataset.paginationBound = "true";

    const pageSize = Number(pagination.dataset.pageSize);
    const total = Number(pagination.dataset.total);
    const template = pagination.dataset.template || "";
    const templateSingle = pagination.dataset.templateSingle || "";
    const pageLabel = pagination.dataset.pageLabel || "";

    const items = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-project-item]"),
    );
    const buttons = Array.from(
      pagination.querySelectorAll<HTMLButtonElement>("[data-page-btn]"),
    );
    const totalPages = Math.ceil(total / pageSize);

    // Matches the lg:grid-cols-3 layout: the widest first row any
    // breakpoint can show, so it covers sm/lg alike.
    const FIRST_ROW_SIZE = 3;

    const eagerLoadFirstRow = (page: number) => {
      items
        .filter((item) => Number(item.dataset.page) === page)
        .slice(0, FIRST_ROW_SIZE)
        .forEach((item) => {
          const img = item.querySelector("img");
          if (img && img.loading !== "eager") img.loading = "eager";
        });
    };

    const setPage = (page: number, { scroll = true } = {}) => {
      // Before revealing the page, switch its first row to eager so the
      // fetch kicks off immediately instead of waiting on the browser's
      // lazy-load intersection check right as the cards become visible.
      eagerLoadFirstRow(page);

      items.forEach((item) => {
        item.hidden = Number(item.dataset.page) !== page;
      });

      buttons.forEach((button) => {
        const target = button.dataset.pageBtn;
        if (target === "prev") {
          button.disabled = page <= 1;
        } else if (target === "next") {
          button.disabled = page >= totalPages;
        } else {
          const isCurrent = Number(target) === page;
          if (isCurrent) {
            button.setAttribute("aria-current", "page");
          } else {
            button.removeAttribute("aria-current");
          }
          button.setAttribute(
            "aria-label",
            pageLabel.replace("{n}", target || ""),
          );
        }
      });

      const start = (page - 1) * pageSize + 1;
      const end = Math.min(page * pageSize, total);
      status.textContent =
        start === end
          ? templateSingle
              .replace("{n}", String(start))
              .replace("{total}", String(total))
          : template
              .replace("{start}", String(start))
              .replace("{end}", String(end))
              .replace("{total}", String(total));

      pagination.dataset.currentPage = String(page);

      if (scroll) {
        grid.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    };

    pagination.addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-page-btn]",
      );
      if (!button || button.disabled) return;

      const current = Number(pagination.dataset.currentPage) || 1;
      const target = button.dataset.pageBtn;
      const nextPage =
        target === "prev"
          ? current - 1
          : target === "next"
            ? current + 1
            : Number(target);

      setPage(nextPage);
    });

    setPage(1, { scroll: false });
  }

  document.addEventListener("astro:page-load", initProjectsPagination);
</script>
