---
import MainLayout from "../../../layouts/MainLayout.astro";
import Navbar from "../../layout/Navbar.astro";
import Footer from "../../layout/Footer.astro";
import ContactDrawer from "../../ui/ContactDrawer.tsx";
import TravelingGlow from "../../ui/TravelingGlow.astro";
import ProjectHero from "./ProjectHero.astro";
import ProjectShowcase from "./ProjectShowcase.astro";
import ProjectOverview from "./ProjectOverview.astro";
import ProjectContributions from "./ProjectContributions.astro";
import ProjectTestimonial from "./ProjectTestimonial.astro";
import ProjectFinalCTA from "./ProjectFinalCTA.astro";
import ProjectRelatedServices from "./ProjectRelatedServices.astro";
import ProjectStickyCTA from "./ProjectStickyCTA.astro";
import type { Locale } from "../../../i18n/ui";
import { getAlternatePaths, getRouteUrl } from "../../../i18n/routes";
import { useTranslations } from "../../../i18n/utils";
import type { Project } from "../../../types/project";
import {
  buildBreadcrumbSchema,
  getSiteUrl,
  type BreadcrumbItem,
} from "../../../lib/schema";

interface Props {
  project: Project;
  lang: Locale;
}

const { project, lang } = Astro.props;
const alternates = getAlternatePaths("projects", project.slugs);

const t = useTranslations(lang);
const siteUrl = getSiteUrl(Astro.site);

// Defined once, then handed to both ProjectHero (rendered nav) and the
// BreadcrumbList markup, so the two cannot drift apart.
const crumbs: BreadcrumbItem[] = [
  { label: t("nav.projects"), href: getRouteUrl(lang, "projects") },
  { label: project.title },
];

const jsonLd = [
  buildBreadcrumbSchema(
    siteUrl,
    t("breadcrumb.home"),
    getRouteUrl(lang, "home"),
    crumbs,
  ),
];
---

<MainLayout
  lang={lang}
  title={`${project.title} | CHRod Dev - Web Developer`}
  description={project.description}
  alternates={alternates}
  showWhatsAppButton={false}
  jsonLd={jsonLd}
>
  <Navbar lang={lang} alternates={alternates} />
  <main>
    <TravelingGlow>
      <ProjectHero project={project} lang={lang} crumbs={crumbs} />
      <ProjectShowcase project={project} lang={lang} />
      <ProjectOverview project={project} lang={lang} />
      <ProjectContributions project={project} lang={lang} />
      <ProjectTestimonial project={project} lang={lang} />
      <ProjectFinalCTA lang={lang} />
      <ProjectRelatedServices project={project} lang={lang} />
    </TravelingGlow>
  </main>
  <Footer lang={lang} />
  <ProjectStickyCTA lang={lang} />
  <ContactDrawer client:load lang={lang} />
</MainLayout>
