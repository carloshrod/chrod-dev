---
import Container from "../../layout/Container.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="project-final-cta" class="bg-surface-alt py-20">
  <Container>
    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="mb-4 text-3xl font-bold text-slate-100 sm:text-4xl"
        data-scroll-animate="up"
      >
        {t("project.page.finalCta.heading")}
      </h2>
      <p class="mb-8 text-slate-400" data-scroll-animate="up">
        {t("project.page.finalCta.subheading")}
      </p>

      <button
        id="project-final-cta-btn"
        data-open-contact
        data-wiggle-trigger
        class="rounded-lg bg-red-600 px-8 py-3.5 text-sm font-semibold text-white transition-all hover:bg-red-500 hover:shadow-lg hover:shadow-red-500/25 cursor-pointer"
        data-scroll-animate="scale"
      >
        {t("project.page.finalCta.button")}
      </button>
    </div>
  </Container>
</section>
