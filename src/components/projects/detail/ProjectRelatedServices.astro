---
import Container from "../../layout/Container.astro";
import Icon from "../../../components/ui/icons.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import { getRouteUrl } from "../../../i18n/routes";
import type { Project } from "../../../types/project";
import { getServiceById } from "../../../data/services";

interface Props {
  project: Project;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const relatedServices = (project.services ?? [])
  .map((id) => getServiceById(id))
  .filter((service): service is NonNullable<typeof service> =>
    Boolean(service),
  );

const projectsUrl = getRouteUrl(lang, "projects");
---

{
  relatedServices.length > 0 && (
    <section class="py-16">
      <Container>
        <h2
          class="mb-10 text-center text-2xl font-bold text-slate-100 sm:text-3xl"
          data-scroll-animate="up"
        >
          {t("project.page.relatedServices.heading")}
        </h2>
        <div class="flex flex-wrap justify-center gap-3 mb-16">
          {relatedServices.map((service) => (
            <a
              href={getRouteUrl(lang, "services", service.slug[lang])}
              class="group inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-slate-300 transition-all duration-300 hover:border-red-600/40 hover:text-red-400"
              data-scroll-animate="up"
            >
              <span class="inline-flex h-4 w-4 shrink-0 text-red-400 [&_svg]:h-4 [&_svg]:w-4">
                <Fragment set:html={service.icon} />
              </span>
              {service.card.title[lang]}
            </a>
          ))}
        </div>

        <div class="group flex justify-center">
          <a
            href={projectsUrl}
            class="inline-flex items-center gap-1 px-7 py-3 text-sm font-semibold text-slate-200 transition-all hover:border-red-400 hover:text-red-400"
            data-scroll-animate="up"
          >
            <Icon
              name="arrowLeft"
              class="h-3 w-3 transition-transform duration-300 group-hover:-translate-x-0.5"
            />{" "}
            {t("projects.viewAll")}
          </a>
        </div>
      </Container>
    </section>
  )
}
