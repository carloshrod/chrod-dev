---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "../../layout/Container.astro";
import Breadcrumbs from "../../ui/Breadcrumbs.astro";
import { useTranslations } from "../../../i18n/utils";
import type { Locale } from "../../../i18n/ui";
import type { Project } from "../../../types/project";

interface Props {
  project: Project;
  lang: Locale;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const projectsUrl = getRelativeLocaleUrl(lang, "/projects");
---

<section id="project-hero" class="relative overflow-hidden pb-8 pt-32">
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-125 w-150 -translate-x-1/2 -translate-y-1/3"
    aria-hidden="true"
    style="background: radial-gradient(ellipse at center, rgba(220,38,38,0.1) 0%, rgba(220,38,38,0.04) 40%, transparent 70%);"
  >
  </div>
  <Container>
    <Breadcrumbs
      lang={lang}
      items={[
        { label: t("nav.projects"), href: projectsUrl },
        { label: project.title },
      ]}
    />

    <h1
      class="max-w-3xl text-4xl font-bold leading-tight text-slate-100 sm:text-5xl"
    >
      {project.title}
    </h1>
  </Container>
</section>
