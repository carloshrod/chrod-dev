---
import ServicePage from "../../../components/services/detail/ServicePage.astro";
import { getServiceBySlug, getServiceSlugs } from "../../../data/services";

export function getStaticPaths() {
  return getServiceSlugs("es").map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!, "es");

if (!service) {
  return Astro.redirect("/es");
}
---

<ServicePage service={service} lang="es" />
