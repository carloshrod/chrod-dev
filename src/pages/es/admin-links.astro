---
// Internal-only tool: generates signed WhatsApp onboarding links for clients.
// Lives under /es/ purely so Astro's i18n router recognizes it as a real
// route (a top-level page outside the locale folders rendered fine but came
// back with a forced 404 status — 404.astro is the only filename exempt from
// that). Single language on purpose: no nav entry, no translations needed.
// Gated by ADMIN_ACCESS_TOKEN the same way /review is gated by REVIEW_ACCESS_TOKEN.
import "../../styles/global.css";
import ModeSelect from "../../components/ui/ModeSelect.tsx";

export const prerender = false;

const token = Astro.url.searchParams.get("t") ?? "";
const validToken = import.meta.env.ADMIN_ACCESS_TOKEN;
const isValid = Boolean(validToken && token === validToken);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>WhatsApp Onboarding Links - CHRod Dev</title>
    <link rel="icon" type="image/png" href="/chrod-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#06060c] text-slate-200 antialiased min-h-screen">
    <div class="min-h-screen flex flex-col">
      <header class="border-b border-slate-800/60 py-4 px-6">
        <div class="max-w-xl mx-auto flex items-center gap-2.5">
          <img
            src="/chrod-logo.png"
            alt="CHRod Dev"
            class="h-10 w-auto opacity-90"
          />
          <span class="text-sm text-slate-500">Admin</span>
        </div>
      </header>

      <main class="flex-1 py-12 px-6">
        <div class="max-w-xl mx-auto">
          <div class="mb-8">
            <h1 class="text-2xl font-bold text-white tracking-tight mb-2">
              WhatsApp Onboarding Links
            </h1>
            <p class="text-slate-400 text-sm leading-relaxed">
              Genera un link firmado y específico para cada cliente, para
              conectar su número a la API de WhatsApp.
            </p>
          </div>

          <div
            class="rounded-2xl border border-border bg-surface p-6 sm:p-8 shadow-xl shadow-black/30"
          >
            {
              isValid ? (
                <>
                  <form id="link-form" class="space-y-4">
                    <div class="space-y-1.5">
                      <label
                        for="client-name"
                        class="block text-sm font-medium text-slate-300"
                      >
                        Nombre del cliente
                      </label>
                      <input
                        id="client-name"
                        type="text"
                        placeholder="ej. Clínica Estética"
                        maxlength="100"
                        required
                        class="w-full rounded-lg border border-border bg-surface-alt px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 outline-none transition-all focus:border-slate-300 focus:ring-2 focus:ring-slate-300/30"
                      />
                    </div>
                    <div class="space-y-1.5">
                      <span class="block text-sm font-medium text-slate-300">
                        Modo de conexión
                      </span>
                      <ModeSelect
                        id="client-mode"
                        defaultValue="coexistence"
                        options={[
                          { value: "coexistence", label: "Coexistence" },
                          { value: "api_only", label: "Solo API" },
                        ]}
                        client:load
                      />
                      <p
                        id="mode-description"
                        class="text-xs text-slate-500 leading-relaxed pt-0.5"
                      >
                        El cliente ya usa la app de WhatsApp Business y quiere
                        seguir usándola. Su número sigue funcionando también
                        desde el teléfono.
                      </p>
                    </div>
                    <div class="space-y-1.5">
                      <label
                        for="client-email"
                        class="block text-sm font-medium text-slate-300"
                      >
                        Email del cliente{" "}
                        <span class="text-slate-500 font-normal">
                          (opcional)
                        </span>
                      </label>
                      <input
                        id="client-email"
                        type="email"
                        placeholder="cliente@ejemplo.com"
                        maxlength="200"
                        class="w-full rounded-lg border border-border bg-surface-alt px-4 py-2.5 text-sm text-slate-200 placeholder-slate-600 outline-none transition-all focus:border-slate-300 focus:ring-2 focus:ring-slate-300/30"
                      />
                      <p class="text-xs text-slate-500 leading-relaxed pt-0.5">
                        Si lo dejas, le llega un correo de confirmación al
                        cliente cuando termine de conectar su WhatsApp.
                      </p>
                    </div>
                    <button
                      type="submit"
                      id="generate-btn"
                      class="w-full rounded-lg bg-red-600 py-3 text-sm font-semibold text-white transition-all hover:bg-red-500 hover:shadow-lg hover:shadow-red-500/20 cursor-pointer disabled:cursor-not-allowed disabled:opacity-60"
                    >
                      Generar link
                    </button>
                  </form>

                  <div id="error-box" class="hidden mt-4 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3">
                    <p class="text-sm text-red-400" id="error-text" />
                  </div>

                  <div id="result-box" class="hidden mt-6 space-y-3">
                    <div>
                      <p class="text-xs font-medium text-slate-500 mb-1.5">
                        Link en español
                      </p>
                      <div class="flex gap-2">
                        <input
                          id="url-es"
                          type="text"
                          readonly
                          class="flex-1 rounded-lg border border-border bg-surface-alt px-3 py-2 text-xs text-slate-300 outline-none"
                        />
                        <button
                          type="button"
                          data-copy-target="url-es"
                          class="copy-btn shrink-0 rounded-lg border border-border px-3 py-2 text-xs font-medium text-slate-300 hover:bg-surface-raised transition-colors cursor-pointer"
                        >
                          Copiar
                        </button>
                      </div>
                    </div>
                    <div>
                      <p class="text-xs font-medium text-slate-500 mb-1.5">
                        Link en inglés
                      </p>
                      <div class="flex gap-2">
                        <input
                          id="url-en"
                          type="text"
                          readonly
                          class="flex-1 rounded-lg border border-border bg-surface-alt px-3 py-2 text-xs text-slate-300 outline-none"
                        />
                        <button
                          type="button"
                          data-copy-target="url-en"
                          class="copy-btn shrink-0 rounded-lg border border-border px-3 py-2 text-xs font-medium text-slate-300 hover:bg-surface-raised transition-colors cursor-pointer"
                        >
                          Copiar
                        </button>
                      </div>
                    </div>
                  </div>
                </>
              ) : (
                <div class="flex flex-col items-center justify-center text-center py-16 px-4">
                  <div class="w-14 h-14 rounded-full bg-red-500/10 flex items-center justify-center mb-5">
                    <svg
                      class="w-7 h-7 text-red-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"
                      />
                    </svg>
                  </div>
                  <h2 class="text-xl font-semibold text-white mb-2">
                    Acceso inválido
                  </h2>
                  <p class="text-slate-500 text-sm max-w-xs">
                    Falta el token o es incorrecto.
                  </p>
                </div>
              )
            }
          </div>
        </div>
      </main>
    </div>

    {
      isValid && (
        <script define:vars={{ adminToken: token }}>
          const form = document.getElementById("link-form");
          const btn = document.getElementById("generate-btn");
          const errorBox = document.getElementById("error-box");
          const errorText = document.getElementById("error-text");
          const resultBox = document.getElementById("result-box");
          const urlEs = document.getElementById("url-es");
          const urlEn = document.getElementById("url-en");
          const modeSelect = document.getElementById("client-mode");
          const modeDescription = document.getElementById("mode-description");

          const MODE_DESCRIPTIONS = {
            coexistence:
              "El cliente ya usa la app de WhatsApp Business y quiere seguir usándola. Su número sigue funcionando también desde el teléfono.",
            api_only:
              "El número (nuevo o ya existente) queda conectado por completo a la API. Si hoy tiene WhatsApp o WhatsApp Business instalado, deja de funcionar ahí.",
          };

          modeSelect.addEventListener("change", () => {
            modeDescription.textContent = MODE_DESCRIPTIONS[modeSelect.value];
          });

          form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const clientName = document.getElementById("client-name").value.trim();
            const mode = document.getElementById("client-mode").value;
            const clientEmail = document.getElementById("client-email").value.trim();
            if (!clientName) return;

            errorBox.classList.add("hidden");
            resultBox.classList.add("hidden");
            btn.disabled = true;
            btn.textContent = "Generando…";

            try {
              const res = await fetch("/api/generate-onboard-link", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ clientName, mode, clientEmail, adminToken }),
              });
              const data = await res.json();

              if (!res.ok) {
                throw new Error(data.error || "No se pudo generar el link.");
              }

              urlEs.value = data.urls.es;
              urlEn.value = data.urls.en;
              resultBox.classList.remove("hidden");
            } catch (err) {
              errorText.textContent = err.message || "Algo salió mal.";
              errorBox.classList.remove("hidden");
            } finally {
              btn.disabled = false;
              btn.textContent = "Generar link";
            }
          });

          document.querySelectorAll(".copy-btn").forEach((button) => {
            button.addEventListener("click", async () => {
              const targetId = button.getAttribute("data-copy-target");
              const input = document.getElementById(targetId);
              await navigator.clipboard.writeText(input.value);
              const original = button.textContent;
              button.textContent = "¡Copiado!";
              setTimeout(() => {
                button.textContent = original;
              }, 1500);
            });
          });
        </script>
      )
    }
  </body>
</html>
