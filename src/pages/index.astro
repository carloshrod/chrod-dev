---
export const prerender = false;

import type { Locale } from "../i18n/ui";

/**
 * Language-negotiated entry point for `/`.
 *
 * The status depends on whether the request expresses a language preference,
 * because the two cases are genuinely different resources.
 *
 * A request carrying `Accept-Language` gets 302. The target varies per
 * request, which is what a temporary redirect means, and a cached permanent
 * one would pin the language picked on a visitor's first ever request for
 * every later visit to `/`, undoable only by clearing site data.
 *
 * A request carrying no `Accept-Language` always gets the default locale,
 * so for that client the answer is not temporary at all, and 301 says so.
 * This is not user-agent sniffing: it keys on whether the request states a
 * preference, which is the single thing this endpoint negotiates on.
 *
 * That split exists because a 302 keeps the canonical on the redirecting URL
 * while a 301 passes it to the target. Search Console showed the consequence:
 * Google indexed `/` and excluded `/es/` as "Duplicate, Google chose a
 * different canonical than the user", so the indexed Spanish home sat outside
 * the hreflang cluster, which only ever named `/es/` and `/en/`. Googlebot
 * sends no `Accept-Language`, so it now gets the permanent redirect and the
 * sitemap, the hreflang pair and the index all name the same URL. An earlier
 * version of this comment claimed search engines were unaffected either way.
 * They were not.
 *
 * `Vary: Accept-Language` is the honest declaration that the target depends
 * on a request header rather than on the URL alone, though Netlify strips it
 * from the response and sends its own `Netlify-Vary` instead. `no-store` is
 * what actually keeps anything from storing either status, verified against
 * production (`fwd=bypass` on Durable, `fwd=miss` on Edge), and it is why no
 * browser ever holds on to the 301.
 */
const SUPPORTED: readonly Locale[] = ["es", "en"];
const DEFAULT_LOCALE: Locale = "es";

function negotiateLocale(header: string | null): Locale {
  if (!header) return DEFAULT_LOCALE;

  const ranked = header
    .split(",")
    .map((part) => {
      const [tag, ...params] = part.trim().split(";");
      const qParam = params.find((p) => p.trim().startsWith("q="));
      const quality = qParam ? Number.parseFloat(qParam.split("=")[1]) : 1;
      return {
        // `en-US` and `en-GB` both negotiate to `en`. Underscores are not
        // valid in BCP 47 but some clients send `en_US` anyway.
        base: tag.trim().toLowerCase().split(/[-_]/)[0],
        quality: Number.isFinite(quality) ? quality : 0,
      };
    })
    // `q=0` is an explicit refusal of that language, not a weak preference.
    .filter((entry) => entry.quality > 0)
    .sort((a, b) => b.quality - a.quality);

  const match = ranked.find((entry) =>
    SUPPORTED.includes(entry.base as Locale),
  );

  return match ? (match.base as Locale) : DEFAULT_LOCALE;
}

const acceptLanguage = Astro.request.headers.get("accept-language");
const locale = negotiateLocale(acceptLanguage);

// An empty header states no preference just as a missing one does. A header
// listing only unsupported languages does state one, and still negotiates to
// the default, so it keeps the temporary status.
const statesPreference = (acceptLanguage ?? "").trim().length > 0;

// The query string has to survive the hop. Campaign links land on the bare
// domain (`chrod.dev/?utm_source=...`), and dropping the params here would
// silently attribute every one of those visits to direct traffic. The URL
// fragment needs no handling: it never reaches the server, and the browser
// carries it over to the redirect target on its own.
const target = `/${locale}/${Astro.url.search}`;

return new Response(null, {
  status: statesPreference ? 302 : 301,
  headers: {
    Location: target,
    Vary: "Accept-Language",
    "Cache-Control": "no-store",
  },
});
---
